# voxup.ini: where things are. voxup writes a short one itself on its first start (and asks for sprites); this file
# lists every key. Lines are "key = value"; # starts a comment. Nothing here is needed to open the window.

# the original sprites, NNN.png (000.png, 001.png, ...), up to 32 x 32
sprites = C:\path\to\sprites
# optional: item names, lines "N: name" (or "N: a_name")
names = C:\path\to\names.txt
# optional, may repeat: item descriptions for the prompt, lines "N|what it is"
desc = C:\path\to\descriptions.txt
# optional: your own enlarged sprites: NNN.png (shown beside the original) and raw\NNN_in.raw (the picture the models
# start from: width and height as 4-byte integers, then RGBA). Without it the original sprite itself is used.
enlarged = C:\path\to\enlarged
# optional, may repeat (up to 4, the first with the file wins): the items stood upright, NNN.png at 32 x 32. Shown as
# the third picture; "Draw from" can give it to the models (the sprite is then shrunk into its box)
# upright = C:\path\to\upright
# ComfyUI: its folder (with .venv\Scripts\python.exe and main.py), and optionally an extra_model_paths.yaml
comfy = C:\path\to\ComfyUI
comfy_paths = C:\path\to\extra_model_paths.yaml
# the models folder (diffusion_models, text_encoders, vae, checkpoints, loras ...): Get puts files here, ComfyUI
# and the built-in engine read them from here. Without it: model-files beside voxup.exe
model_files = C:\path\to\ComfyUI\models
# the models whose licences were accepted (Get adds to it)
# licence_ok = qwen2511g
port = 8189
# where Keep writes NNN.png (may repeat, up to 4); the biggest picture the game takes
game = C:\path\to\game\sprites
game_max = 32
# optional: where rounds, keeps and logs go (default out\pick beside the exe); a model list of your own (default: the
# one built into voxup.exe; a models folder beside the exe wins, file by file)
# work = C:\path\to\voxup-work
# models = C:\path\to\models
# optional: how many item numbers there are (up to 512), and numbers left out of the list
# items = 320
# skip = 64-127, 15
